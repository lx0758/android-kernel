# CONFIG_MODULE_SIG_ALL is not set

# NOTE: This is a mixed-build board kernel.  Its base kernel is the shared
# GKI (see `base_kernel = ":kernel_aarch64"` in BUILD.bazel), so:
#
#   * bool symbols selected with "=y" are compiled into the GKI vmlinux, not
#     into this board kernel.  A board kernel has no vmlinux of its own
#     (common/scripts/Makefile.build drops obj-y entries in a mixed build),
#     so a bool "=y" here silently disappears.
#   * tristate symbols must be "=m" so that they are built as board modules
#     and listed in _ORANGEPI3B_MODULE_OUTS.
#
# The Rockchip SoC support that must live in the GKI vmlinux is configured in
# the shared arch/arm64/configs/gki_defconfig:
#   CONFIG_ARCH_ROCKCHIP=y            (selects the whole Rockchip platform)
#   CONFIG_ROCKCHIP_IOMMU=y
#   CONFIG_PCIE_ROCKCHIP_DW_HOST=y
# CONFIG_ROCKCHIP_PM_DOMAINS is a bool with "default ARCH_ROCKCHIP", so it
# follows CONFIG_ARCH_ROCKCHIP=y automatically and needs no explicit line.

# Serial
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Core features
CONFIG_COMMON_CLK_RK808=m
# CONFIG_CPUFREQ_DT_PLATDEV is a bool symbol and is selected by
# CONFIG_CPUFREQ_DT; it must not be set to "m" here.
CONFIG_CPUFREQ_DT=m
CONFIG_MFD_RK8XX=m
CONFIG_MFD_RK8XX_I2C=m
CONFIG_PHY_ROCKCHIP_PCIE=m
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=m
CONFIG_PHY_ROCKCHIP_INNO_USB2=m
CONFIG_PL330_DMA=m
CONFIG_PWM_ROCKCHIP=m
CONFIG_PWRSEQ_SIMPLE=m
CONFIG_REGULATOR_FAN53555=m
CONFIG_REGULATOR_PWM=m
CONFIG_REGULATOR_RK808=m
CONFIG_NVMEM_ROCKCHIP_EFUSE=m
CONFIG_NVMEM_ROCKCHIP_OTP=m
CONFIG_ROCKCHIP_IODOMAIN=m
CONFIG_ROCKCHIP_THERMAL=m
CONFIG_ROCKCHIP_SARADC=m
CONFIG_ROCKCHIP_VOP2=y

# Watchdog
CONFIG_DW_WATCHDOG=m

# I2C
CONFIG_I2C_RK3X=m

# Real-time clock
CONFIG_RTC_DRV_RK808=m
CONFIG_INPUT_RK805_PWRKEY=m

# SPI
CONFIG_SPI_ROCKCHIP=m
CONFIG_SPI_ROCKCHIP_SFC=m

# eMMC / SD-Card
CONFIG_MMC_SDHCI_OF_ARASAN=m
CONFIG_MMC_SDHCI_OF_DWCMSHC=m
CONFIG_MMC_DW=m
CONFIG_MMC_DW_PLTFM=m
CONFIG_MMC_DW_ROCKCHIP=m
CONFIG_PHY_ROCKCHIP_EMMC=m

# Display
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_ANALOGIX_DP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_BACKLIGHT_PWM=m

# Ethernet
CONFIG_STMMAC_ETH=m
CONFIG_STMMAC_PLATFORM=m
CONFIG_DWMAC_GENERIC=m
CONFIG_DWMAC_ROCKCHIP=m
# CONFIG_DWMAC_SUN8I is not set
# CONFIG_DWMAC_SUNXI is not set
# CONFIG_DWMAC_IPQ806X is not set
# CONFIG_DWMAC_QCOM_ETHQOS is not set

# Sound
# NOTE: there is no aggregate CONFIG_SND_SOC_ROCKCHIP symbol in this kernel
# tree anymore (it was split into the per-IP drivers below), so referencing
# it here would fail kleaf's config check.
CONFIG_SND_SOC_ROCKCHIP_I2S=m
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
CONFIG_SND_SOC_ROCKCHIP_PDM=m
CONFIG_SND_SOC_ROCKCHIP_SPDIF=m

# Video
CONFIG_VIDEO_ROCKCHIP_RGA=m

# Reboot / Power off
# The RK809 PMIC provides the system power-off handler (rk8xx-core.c:
# rk808_power_off) via the "system-power-controller" property, and the
# reboot-mode node is handled by the syscon-reboot-mode driver.
CONFIG_SYSCON_REBOOT_MODE=m

# OP-TEE
# The TEE framework and the OP-TEE driver are both tristate, so they are
# built as board modules (drivers/tee/tee.ko, drivers/tee/optee/optee.ko).
CONFIG_TEE=m
CONFIG_OPTEE=m
